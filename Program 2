def rotate_left_without_carry(num, positions):
    print("\nROTATE LEFT WITHOUT CARRY (ROL)")
    print("Original Number:", format(num, '08b'))

    for i in range(positions):
        msb = (num >> 7) & 1
        num = ((num << 1) & 0xFF) | msb

        print("After rotation", i + 1, ":",
              format(num, '08b'))

    print("Final Result:", format(num, '08b'))


def rotate_left_with_carry(num, positions):
    carry = 0

    print("\nROTATE LEFT WITH CARRY (RCL)")
    print("Original Number:", format(num, '08b'))
    print("Initial Carry Flag:", carry)

    for i in range(positions):
        msb = (num >> 7) & 1

        num = ((num << 1) & 0xFF) | carry
        carry = msb

        print("After rotation", i + 1, ":",
              format(num, '08b'),
              "Carry Flag:", carry)

    print("Final Result:", format(num, '08b'))
    print("Final Carry Flag:", carry)


number = 0b10110110

rotate_left_without_carry(number, 2)

rotate_left_with_carry(number, 2)
